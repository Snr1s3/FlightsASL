DROP DATABASE IF EXISTS "FLIGHTSASL";

SELECT 'CREATE DATABASE "FLIGHTSASL"'
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = 'FLIGHTSASL')
\gexec

\c "FLIGHTSASL"

CREATE TABLE IF NOT EXISTS airports (
    id SERIAL PRIMARY KEY,
    name VARCHAR(120) NOT NULL,
    iata VARCHAR(8),
    icao VARCHAR(8),
    lat DOUBLE PRECISION,
    lon DOUBLE PRECISION,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT uq_airports_iata UNIQUE (iata),
    CONSTRAINT uq_airports_icao UNIQUE (icao)
);

CREATE TABLE IF NOT EXISTS flights (
    id SERIAL PRIMARY KEY,
    id_flight VARCHAR(10),
    number VARCHAR(16),
    origin VARCHAR(120),
    origin_iata VARCHAR(8),
    destination VARCHAR(120),
    destination_iata VARCHAR(8),
    scheduled_departure VARCHAR(40),
    utc_departure BIGINT,
    scheduled_arrival VARCHAR(40),
    utc_arrival BIGINT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT uq_flights_id_flight UNIQUE (id_flight),
    CONSTRAINT chk_id_flight_len CHECK (id_flight IS NULL OR char_length(id_flight) BETWEEN 8 AND 10),
    CONSTRAINT chk_number_len CHECK (number IS NULL OR char_length(number) BETWEEN 1 AND 16),
    CONSTRAINT chk_origin_len CHECK (origin IS NULL OR char_length(origin) BETWEEN 1 AND 120),
    CONSTRAINT chk_origin_iata_len CHECK (origin_iata IS NULL OR char_length(origin_iata) BETWEEN 3 AND 8),
    CONSTRAINT chk_destination_len CHECK (destination IS NULL OR char_length(destination) BETWEEN 1 AND 120),
    CONSTRAINT chk_destination_iata_len CHECK (destination_iata IS NULL OR char_length(destination_iata) BETWEEN 3 AND 8)
);

CREATE INDEX IF NOT EXISTS idx_flights_origin_iata ON flights (origin_iata);
CREATE INDEX IF NOT EXISTS idx_flights_destination_iata ON flights (destination_iata);
CREATE INDEX IF NOT EXISTS idx_flights_utc_departure ON flights (utc_departure);
CREATE INDEX IF NOT EXISTS idx_flights_utc_arrival ON flights (utc_arrival);